{
  "name": "employee-referral",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  // No database_id on purpose: Cloudflare creates (or reuses) a D1 database
  // named "referleey" on the first deploy and links it as env.DB.
  "d1_databases": [{ "binding": "DB", "database_name": "referleey" }],
  "observability": { "enabled": true }
}
